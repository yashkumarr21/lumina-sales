# Server Environment
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000

# Authentication (Random secure string)
JWT_SECRET=your-random-production-jwt-secret-key-change-me

# MongoDB Atlas Connection
# Standard SRV connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/lumina_sales?retryWrites=true&w=majority

# Optional: direct replica set URI or credentials for specific environments
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DIRECT_URI=
